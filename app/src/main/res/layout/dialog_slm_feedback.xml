<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/slmTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Análisis Técnico de la Serie" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/slmSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="14sp" />
    <ProgressBar android:id="@+id/slmProgress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true"
        android:layout_marginTop="16dp" />
    <TextView android:id="@+id/slmStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="Analizando biomecánica de la serie..." />
    <ScrollView android:id="@+id/slmScroll" android:layout_width="match_parent" android:layout_height="300dp"
        android:layout_marginTop="10dp" android:fillViewport="true">
        <TextView android:id="@+id/slmOutput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:lineSpacingMultiplier="1.3" android:textIsSelectable="true" />
    </ScrollView>
    <TextView android:id="@+id/slmMissing" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" android:paddingTop="12dp" android:textIsSelectable="true" />
    <Button android:id="@+id/slmSelectModel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" android:text="SELECCIONAR ARCHIVO (.GGUF)" />
    <Button android:id="@+id/slmClose" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Cerrar" />
</LinearLayout>
